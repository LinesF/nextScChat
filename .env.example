# Google Gemini API Key (Required for AI streaming)
# Get a key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Gemini Model ID (Optional: default is gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# NEIS Open API Key (Optional: for real-time live meal & schedule sync)
# Get a key: https://open.neis.go.kr
NEIS_API_KEY=
